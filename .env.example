# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=syniqai_metadata
POSTGRES_USER=syniqai_user
POSTGRES_PASSWORD=syniqai_password

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Bucket Names
MINIO_BRONZE_BUCKET=syniqai-bronze
MINIO_SILVER_BUCKET=syniqai-silver
MINIO_GOLD_BUCKET=syniqai-gold
MINIO_QUARANTINE_BUCKET=syniqai-quarantine

# API Configuration
API_HOST=localhost
API_PORT=8000
DEBUG=true

# Processing Configuration
MAX_WORKERS=4
CHUNK_SIZE=10000
RULE_TIMEOUT=300
RULE_CACHING=true
